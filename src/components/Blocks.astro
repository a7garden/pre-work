---
import type { Block } from "../data/blocks";
import RichText from "./RichText.astro";
import Quiz from "./Quiz.astro";
import Icon from "./Icon.astro";

/** 콜아웃 톤 — 색만으로 상태를 나타내지 않도록 아이콘을 짝지운다 */
const toneIcons = {
  note: "info",
  warn: "triangle-alert",
  good: "circle-check",
} as const;

interface Props {
  blocks: Block[];
}

const { blocks } = Astro.props;
let quizIndex = 0;
---

{blocks.map((block) => {
  switch (block.type) {
    case "p":
      return <p><RichText text={block.text} /></p>;

    case "list":
      return block.ordered ? (
        <ol class="b-list b-list--ordered">
          {block.items.map((item) => <li><RichText text={item} /></li>)}
        </ol>
      ) : (
        <ul class="b-list">
          {block.items.map((item) => <li><RichText text={item} /></li>)}
        </ul>
      );

    case "callout":
      return (
        <aside class={`b-callout b-callout--${block.tone ?? "note"}`}>
          <strong>
            <Icon name={toneIcons[block.tone ?? "note"]} size={16} />
            {block.title}
          </strong>
          <p><RichText text={block.text} /></p>
        </aside>
      );

    case "code":
      return (
        <figure class="b-code">
          {block.caption && (
            <figcaption><span>{block.caption}</span><code>{block.language}</code></figcaption>
          )}
          <pre><code>{block.content}</code></pre>
        </figure>
      );

    case "flow":
      return (
        <figure class="b-flow">
          <ol>
            {block.steps.map((step, i) => (
              <li>
                <span class="b-flow__n mono">{i + 1}</span>
                <span class="b-flow__label">{step.label}</span>
                {step.detail && <span class="b-flow__detail">{step.detail}</span>}
              </li>
            ))}
          </ol>
          {block.caption && <figcaption>{block.caption}</figcaption>}
        </figure>
      );

    case "tree":
      return (
        <figure class="b-tree">
          <pre>{block.rows.map((row) => (
            <span class="b-tree__row" style={`--depth:${row.depth ?? 0}`}>
              <span class="b-tree__path">{row.path}</span>
              {row.note && <span class="b-tree__note">{row.note}</span>}
            </span>
          ))}</pre>
          {block.caption && <figcaption>{block.caption}</figcaption>}
        </figure>
      );

    case "table":
      return (
        <figure class="b-table">
          <div class="b-table__scroll">
            <table>
              <thead><tr>{block.head.map((h) => <th>{h}</th>)}</tr></thead>
              <tbody>
                {block.rows.map((row) => (
                  <tr>{row.map((cell, i) => (i === 0 ? <th>{cell}</th> : <td>{cell}</td>))}</tr>
                ))}
              </tbody>
            </table>
          </div>
          {block.caption && <figcaption>{block.caption}</figcaption>}
        </figure>
      );

    case "quiz":
      return (
        <Quiz
          question={block.question}
          code={block.code}
          options={block.options}
          answer={block.answer}
          explain={block.explain}
          index={++quizIndex}
        />
      );

    case "link":
      return (
        <a class="b-link" href={block.href}>
          <span class="b-link__label mono">{block.label}</span>
          <span class="b-link__title">{block.title}</span>
          {block.detail && <span class="b-link__detail">{block.detail}</span>}
          <span class="b-link__arrow" aria-hidden="true">
            <Icon name={block.href.startsWith("http") ? "arrow-up-right" : "arrow-right"} size={16} />
          </span>
        </a>
      );
  }
})}

