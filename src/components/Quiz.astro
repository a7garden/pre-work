---
import Icon from "./Icon.astro";

interface Props {
  question: string;
  code?: { language: string; content: string };
  options: string[];
  answer: number;
  explain: string;
  index?: number;
}

const { question, code, options, answer, explain, index } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---

<div class="quiz" data-quiz data-answer={answer} data-quiz-id={uid}>
  <p class="quiz__q">
    {index !== undefined && <span class="quiz__n mono">{String(index).padStart(2, "0")}</span>}
    {question}
  </p>

  {code && (
    <pre class="quiz__code"><code>{code.content}</code></pre>
  )}

  <div class="quiz__options" role="group" aria-label="보기">
    {options.map((option, i) => (
      <button type="button" class="quiz__option" data-quiz-option={i}>
        <span class="quiz__key mono">{String.fromCharCode(65 + i)}</span>
        <span>{option}</span>
      </button>
    ))}
  </div>

  <div class="quiz__explain" data-quiz-explain hidden>
    <p class="quiz__verdict mono" data-quiz-verdict>
      <Icon name="check" size={16} class="icon-check" />
      <Icon name="x" size={16} class="icon-x" />
      <span data-quiz-verdict-text></span>
    </p>
    <p>{explain}</p>
  </div>
</div>
<script>
  /* ── 보기를 고르면 정오답과 해설이 열린다 — 이슈·스프린트 어디서든 같다 ── */
  document.addEventListener("click", (event) => {
    const option = (event.target as HTMLElement | null)?.closest<HTMLElement>("[data-quiz-option]");
    if (!option) return;
    const quiz = option.closest<HTMLElement>("[data-quiz]");
    if (!quiz) return;
    const answer = Number(quiz.dataset.answer);
    const picked = Number(option.dataset.quizOption);
    quiz.querySelectorAll<HTMLElement>("[data-quiz-option]").forEach((el) => {
      const i = Number(el.dataset.quizOption);
      el.dataset.state = i === answer ? "correct" : i === picked ? "wrong" : "idle";
    });
    const explain = quiz.querySelector<HTMLElement>("[data-quiz-explain]");
    const verdict = quiz.querySelector<HTMLElement>("[data-quiz-verdict]");
    if (verdict) verdict.querySelector<HTMLElement>("[data-quiz-verdict-text]")!.textContent =
      picked === answer ? "정답" : "다시 보기";
    if (verdict) verdict.dataset.state = picked === answer ? "correct" : "wrong";
    if (explain) explain.hidden = false;
    quiz.dataset.done = picked === answer ? "correct" : "wrong";
  });
</script>
