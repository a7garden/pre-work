---
/**
 * 사이트 머리 — 읽기 앱의 최소 내비게이션(N1b 계열).
 * 아이콘은 의미 전달에만 쓴다(design.md). `/` 키로 어디서든 검색으로 이동한다.
 */
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const links = [
  { href: "/", label: "전체 호", icon: "list" },
  { href: "/tags/", label: "태그", icon: "tag" },
  { href: "/search/", label: "검색", icon: "search" },
  { href: "/about/", label: "소개", icon: "info" },
  { href: "/rss.xml", label: "RSS", icon: "rss" },
];

function isActive(href: string) {
  if (href === "/") return path === "/";
  return path.startsWith(href);
}
---

<header class="site-header" data-pagefind-ignore>
  <a class="site-header__brand" href="/">
    <span class="site-header__mark">pre-work</span>
    <span class="site-header__sub">일 하기 전 10분</span>
  </a>
  <nav class="site-header__nav" aria-label="주 메뉴">
    {links.map((l) => (
      <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>
        <Icon name={l.icon} size={16} />{l.label}
      </a>
    ))}
  </nav>
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="테마 전환" title="테마 전환">
    <Icon name="sun" size={16} class="icon-sun" />
    <Icon name="moon" size={16} class="icon-moon" />
  </button>
</header>

<script>
  /* 라이트·다크를 전환한다 — 선택은 이 브라우저 안에서만 남는다 */
  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const prefersDark = () => window.matchMedia("(prefers-color-scheme: dark)").matches;

  const paint = () => {
    const dark =
      document.documentElement.getAttribute("data-theme")
      ?? (prefersDark() ? "dark" : "light");
    btn?.setAttribute("data-next", dark === "dark" ? "light" : "dark");
    btn?.setAttribute("aria-label", dark === "dark" ? "밝은 테마로 전환" : "어두운 테마로 전환");
  };
  paint();

  btn?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme") ?? (prefersDark() ? "dark" : "light");
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    try {
      localStorage.setItem("pw-theme", next);
    } catch (e) {}
    paint();
  });

  /* `/` — 어디서든 검색으로. 검색 페이지에서는 입력란으로 포커스를 옮긴다 */
  document.addEventListener("keydown", (event) => {
    if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    if (target?.closest("input, textarea, select, [contenteditable='true']")) return;
    const searchLink = document.querySelector<HTMLAnchorElement>('.site-header__nav a[href$="search/"]');
    if (!searchLink) return;
    event.preventDefault();
    if (searchLink.getAttribute("aria-current") === "page") {
      document.querySelector<HTMLInputElement>(".pagefind-ui__search-input")?.focus();
    } else {
      try {
        sessionStorage.setItem("pw-focus-search", "1");
      } catch (e) {}
      searchLink.click();
    }
  });
</script>
