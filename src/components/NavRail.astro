---
const path = Astro.url.pathname;

const groups = [
  {
    label: "실무",
    links: [
      { href: "/infra/", title: "프로젝트 인프라 노트" },
      { href: "/stack/", title: "기술 스택" },
    ],
  },
  {
    label: "예습 기록",
    links: [
      { href: "/company/", title: "기관 · 실습 조건" },
      { href: "/si-track/", title: "SI 개발 트랙" },
      { href: "/ai-track/", title: "AI Chatbot 트랙" },
      { href: "/glossary/", title: "핵심 용어 사전" },
    ],
  },
];

function isActive(href: string) {
  if (href === "/") return path === "/";
  return path.startsWith(href);
}
---

<nav class="nav-rail" aria-label="예습서 전체 메뉴">
  <div class="nav-rail__brand">
    <a href="/" class="nav-rail__mark">실무 학습 노트</a>
    <p class="nav-rail__sub">㈜시선아이티 · 산사태정보시스템 고도화</p>
    <span class="nav-rail__dday mono" id="dday-badge">D-1 · 09.01 개시</span>
  </div>

  <div class="nav-rail__groups">
    {groups.map((g) => (
      <div>
        <p class="nav-rail__label">{g.label}</p>
        <div class="nav-rail__links">
          {g.links.map((l) => (
            <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>{l.title}</a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="nav-rail__foot">
    <span class="mono" style="font-size: var(--text-xs); color: var(--color-muted);">2026.09.01–12.31</span>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="화면 밝기 전환">AUTO</button>
  </div>
</nav>

<div class="nav-top">
  <a href="/" class="nav-top__mark">실무 학습 노트</a>
  <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-sheet">MENU</button>
</div>
<div class="nav-sheet" id="nav-sheet">
  {groups.map((g) => (
    <div>
      <p class="nav-rail__label">{g.label}</p>
      <div class="nav-rail__links">
        {g.links.map((l) => (
          <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>{l.title}</a>
        ))}
      </div>
    </div>
  ))}
</div>

<script>
  (function () {
    const toggle = document.getElementById("nav-toggle");
    const sheet = document.getElementById("nav-sheet");
    toggle?.addEventListener("click", () => {
      const open = sheet?.getAttribute("data-open") === "true";
      sheet?.setAttribute("data-open", open ? "false" : "true");
      toggle.setAttribute("aria-expanded", open ? "false" : "true");
      toggle.textContent = open ? "MENU" : "CLOSE";
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && sheet?.getAttribute("data-open") === "true") {
        sheet.setAttribute("data-open", "false");
        toggle?.setAttribute("aria-expanded", "false");
        if (toggle) toggle.textContent = "MENU";
      }
    });
  })();
</script>

<script>
  (function () {
    const start = new Date("2026-09-01T00:00:00+09:00");
    const end = new Date("2026-12-31T23:59:59+09:00");
    const now = new Date();
    const badge = document.getElementById("dday-badge");
    if (badge) {
      const oneDay = 24 * 60 * 60 * 1000;
      if (now < start) {
        const diff = Math.ceil((start.getTime() - now.getTime()) / oneDay);
        badge.textContent = `D-${diff} · 09.01 개시`;
      } else if (now <= end) {
        const day = Math.ceil((now.getTime() - start.getTime()) / oneDay) + 1;
        badge.textContent = `실습 ${day}일차 진행 중`;
      } else {
        badge.textContent = "실습 기간 종료";
      }
    }

    const KEY = "wess-theme";
    const btn = document.getElementById("theme-toggle");
    const root = document.documentElement;
    function apply(mode: string) {
      if (mode === "auto") root.removeAttribute("data-theme");
      else root.setAttribute("data-theme", mode);
      if (btn) btn.textContent = mode.toUpperCase();
    }
    const saved = localStorage.getItem(KEY) || "auto";
    apply(saved);
    btn?.addEventListener("click", () => {
      const cur = localStorage.getItem(KEY) || "auto";
      const next = cur === "auto" ? "light" : cur === "light" ? "dark" : "auto";
      localStorage.setItem(KEY, next);
      apply(next);
    });
  })();
</script>
