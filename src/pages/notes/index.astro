---
import Layout from "../../layouts/Layout.astro";
import { notes } from "../../data/notes";
---

<Layout title="학습 노트" description="실무에서 새로 이해한 구조와 문법을 계속 쌓는 개인 지식 노트입니다.">
  <header class="workspace-head">
    <div>
      <p class="workspace-head__eyebrow mono">KNOWLEDGE BASE</p>
      <h1>학습 노트</h1>
      <p>코드를 읽다가 막힌 지점을 구조, 문법, 배포, 현대화 관점으로 계속 쌓아 둡니다.</p>
    </div>
    <div class="workspace-head__meta mono">{notes.length} notes</div>
  </header>

  <div class="note-toolbar">
    <label class="note-search">
      <span class="sr-only">노트 검색</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m1.35-5.15a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z" /></svg>
      <input id="note-search" type="search" placeholder="노트, 태그, 주제 검색" autocomplete="off" />
    </label>
    <span class="note-toolbar__hint mono">/ to search</span>
  </div>

  <section class="note-grid" aria-label="학습 노트 목록">
    {notes.map((note) => (
      <article class="note-card" data-note-search={`${note.title} ${note.summary} ${note.category} ${note.tags.join(" ")}`}>
        <a href={`/notes/${note.slug}/`}>
          <div class="note-card__top">
            <span>{note.category}</span>
            <span class="mono">{note.minutes} min</span>
          </div>
          <h2>{note.title}</h2>
          <p>{note.summary}</p>
          <div class="note-card__bottom">
            <div class="tag-list">
              {note.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
            </div>
            <span class="note-card__go" aria-hidden="true">→</span>
          </div>
        </a>
      </article>
    ))}
  </section>
  <p class="note-empty" id="note-empty" hidden>찾는 노트가 없습니다. 새 주제는 다음 노트로 추가하면 됩니다.</p>

  <aside class="note-add-guide">
    <div>
      <p class="mono">ADD THE NEXT NOTE</p>
      <h2>새로 이해한 것부터 한 장씩</h2>
      <p>다음에 실무에서 막히는 코드나 개념이 생기면, 제목·핵심 질문·짧은 코드 조각을 기준으로 노트를 이어 붙입니다.</p>
    </div>
    <code>src/data/notes.ts</code>
  </aside>
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>("#note-search");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-note-search]")];
  const empty = document.querySelector<HTMLElement>("#note-empty");

  function filterNotes() {
    const query = input?.value.trim().toLocaleLowerCase() ?? "";
    let visible = 0;
    cards.forEach((card) => {
      const match = card.dataset.noteSearch?.toLocaleLowerCase().includes(query) ?? false;
      card.hidden = !match;
      if (match) visible += 1;
    });
    if (empty) empty.hidden = visible !== 0;
  }

  input?.addEventListener("input", filterNotes);
  document.addEventListener("keydown", (event) => {
    if (event.key === "/" && document.activeElement?.tagName !== "INPUT") {
      event.preventDefault();
      input?.focus();
    }
  });
</script>
