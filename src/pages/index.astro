---
import Layout from "../layouts/Layout.astro";
import { issues } from "../data/issues";
import Icon from "../components/Icon.astro";

const latest = issues[0];
const rest = issues.slice(1);
const total = issues.reduce((n, i) => n + i.minutes, 0);

/* "지금 이어지는 시리즈" — 가장 최근에 발행된 시리즈를 보여 준다.
 * 같은 시리즈의 호들을 오래된 순으로 모아 읽는 순서를 그대로 보여 준다. */
const seriesGroups = new Map<string, typeof issues>();
for (const issue of issues) {
  if (!issue.series) continue;
  const list = seriesGroups.get(issue.series) ?? [];
  list.push(issue);
  seriesGroups.set(issue.series, list);
}
const activeSeriesName = [...seriesGroups.entries()]
  .map(([name, list]) => ({ name, latest: Math.max(...list.map((i) => i.no)) }))
  .sort((a, b) => b.latest - a.latest)[0]?.name;
const activeSeries = activeSeriesName
  ? [...(seriesGroups.get(activeSeriesName) ?? [])].sort((a, b) => a.no - b.no)
  : [];
---

<Layout
  title="오늘"
  description="일 하기 전 10분, 개발자가 꾸준히 성장하기 위한 읽거리입니다."
>
  <header class="today-head">
    <p class="today-head__eyebrow mono">오늘 읽을 것</p>
    <a class="today" href={`/read/${latest.no}/`}>
      <div class="today__stamp mono">
        <span>제{latest.no}호</span>
        <span><Icon name="calendar" size={16} />{latest.date} ({latest.weekday})</span>
        <span><Icon name="clock" size={16} />{latest.minutes}분</span>
      </div>
      <h1>{latest.title}</h1>
      <p class="today__dek">{latest.dek}</p>
      <p class="today__takeaway">
        <span class="mono">한 문장</span>
        <span>{latest.takeaway}</span>
      </p>
      <span class="today__go">읽기 시작 <Icon name="arrow-right" size={16} /></span>
    </a>
  </header>

  {activeSeries.length > 0 && (
    <section class="workspace-section" aria-labelledby="active-series-heading">
      <div class="section-title">
        <div>
          <p class="mono">지금 이어지는 시리즈</p>
          <h2 id="active-series-heading">{activeSeriesName}</h2>
        </div>
        <a class="section-title__meta mono" href="/about/#series-catalog">전체 시리즈 {seriesGroups.size}개 <Icon name="arrow-right" size={16} /></a>
      </div>
      <aside class="issue__series active-series">
        <p class="mono">시리즈 · {activeSeriesName} · {activeSeries.length}편 진행 중</p>
        <ol>
          {activeSeries.map((s) => (
            <li aria-current={s.no === latest.no ? "page" : undefined}>
              <a href={`/read/${s.no}/`}>
                <span class="mono">제{s.no}호</span>
                <span>{s.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    </section>
  )}

  <section class="workspace-section" aria-labelledby="archive-heading">
    <div class="section-title">
      <div>
        <p class="mono">아카이브</p>
        <h2 id="archive-heading">그동안의 호</h2>
      </div>
      <span class="section-title__meta mono">{issues.length}개 호 · 누적 {total}분</span>
    </div>
    <ol class="issue-list">
      {rest.map((issue) => (
        <li>
          <a href={`/read/${issue.no}/`} data-read-mark={`issue-${issue.no}`}>
            <span class="issue-list__no mono">제{issue.no}호</span>
            <div class="issue-list__main">
              <p class="issue-list__title">{issue.title}</p>
              <p class="issue-list__dek">{issue.dek}</p>
              <div class="tag-list">{issue.tags.map((tag) => <span>{tag}</span>)}</div>
            </div>
            <div class="issue-list__meta mono">
              <span>{issue.date} ({issue.weekday})</span>
              <span class="with-icon"><Icon name="clock" size={16} />{issue.minutes}분</span>
              <span class="issue-list__read" data-read-badge>읽음</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <aside class="note-add-guide">
    <div>
      <p class="mono">칼럼 요청</p>
      <h2>읽고 싶은 주제를 이슈로 던지면 칼럼이 됩니다</h2>
      <p>요청은 누구나 할 수 있습니다. 주제를 선별해 발행 대기를 붙이면 자정 파이프라인이 칼럼으로 발행해 배포합니다.</p>
    </div>
    <a class="note-add-guide__file" href="https://github.com/a7garden/pre-work/issues/new?template=publish.yml"><Icon name="arrow-up-right" size={16} />GitHub 이슈로 요청하기</a>
  </aside>
</Layout>

<script>
  /* 읽은 호를 기억해 목록에 표시한다 — 이 브라우저 안에서만 남는다 */
  const KEY = "pw-read";
  let read: string[] = [];
  try {
    read = JSON.parse(localStorage.getItem(KEY) ?? "[]");
  } catch (e) {
    read = [];
  }
  document.querySelectorAll<HTMLElement>("[data-read-mark]").forEach((el) => {
    if (read.includes(el.dataset.readMark!)) el.dataset.read = "true";
  });
</script>
