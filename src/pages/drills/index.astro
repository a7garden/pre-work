---
import Layout from "../../layouts/Layout.astro";
import { drills } from "../../data/drills";

const levelLabel: Record<number, string> = { 1: "읽기", 2: "추적", 3: "판단" };
const total = drills.reduce((n, d) => n + d.minutes, 0);
---

<Layout
  title="코드 읽기 훈련"
  description="실제 레거시 코드를 줄 단위로 읽고 스스로 답해 보는 훈련 모음입니다."
>
  <header class="workspace-head">
    <div>
      <p class="workspace-head__eyebrow mono">DRILLS</p>
      <h1>코드 읽기 훈련</h1>
      <p>설명을 먼저 읽지 않습니다. 코드를 보고 스스로 답한 뒤에 해설을 엽니다. 줄 번호 옆의 표시를 누르면 그 줄의 해설이 열립니다.</p>
    </div>
    <div class="workspace-head__meta mono">{drills.length}편 · {total}분</div>
  </header>

  <div class="drill-legend">
    <span><i data-level="1"></i>읽기 — 문법과 표시를 알아본다</span>
    <span><i data-level="2"></i>추적 — 화면과 코드 사이를 오간다</span>
    <span><i data-level="3"></i>판단 — 함정과 위험을 가려낸다</span>
  </div>

  <div class="drill-grid">
    {drills.map((drill) => (
      <a class="drill-card" href={`/drills/${drill.id}/`} data-level={drill.level} data-read-mark={`drill-${drill.id}`}>
        <div class="drill-card__top">
          <span class="drill-card__no mono">{String(drill.no).padStart(2, "0")}</span>
          <span class="drill-card__level" data-level={drill.level}>{levelLabel[drill.level]}</span>
          <span class="drill-card__done mono" data-read-badge>완료</span>
        </div>
        <h2>{drill.title}</h2>
        <p>{drill.goal}</p>
        <div class="drill-card__bottom">
          <div class="tag-list">{drill.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}</div>
          <span class="mono">{drill.minutes}분</span>
        </div>
      </a>
    ))}
  </div>

  <aside class="note-add-guide">
    <div>
      <p class="mono">훈련 추가하기</p>
      <h2>오늘 읽다 막힌 코드가 가장 좋은 훈련 재료입니다</h2>
      <p>코드와 줄별 해설, 그리고 객관식 하나만 있으면 한 편이 됩니다. 실제 업무 코드는 그대로 옮기지 말고 구조만 남겨 각색합니다.</p>
    </div>
    <a class="note-add-guide__file" href="/authoring/"><code>src/data/drills.ts</code></a>
  </aside>
</Layout>

<script>
  const KEY = "pw-read";
  let read: string[] = [];
  try {
    read = JSON.parse(localStorage.getItem(KEY) ?? "[]");
  } catch (e) {
    read = [];
  }
  document.querySelectorAll<HTMLElement>("[data-read-mark]").forEach((el) => {
    if (read.includes(el.dataset.readMark!)) el.dataset.read = "true";
  });
</script>
