---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="검색" description="발행된 호 전체를 한 번에 검색합니다.">
  <header class="workspace-head">
    <div>
      <p class="workspace-head__eyebrow mono"><Icon name="search" size={16} />SEARCH</p>
      <h1>검색</h1>
      <p>발행된 호 전체를 대상으로 찾습니다. 낱말이 정확할수록 잘 찾힙니다 — 이 사이트의 검색 색인도 BM25 계열 랭킹으로 만들어집니다.</p>
      <p class="search-hint mono">어디서든 <kbd class="kbd">/</kbd> 키를 누르면 이 페이지로 옵니다.</p>
    </div>
  </header>
  <div id="search" class="search-box"></div>
  <p class="search-fallback mono" data-search-fallback>
    색인을 불러 오지 못했습니다. 검색은 배포된 사이트에서 동작합니다.
  </p>
</Layout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" is:inline />
<script is:inline src="/pagefind/pagefind-ui.js" defer></script>
<script is:inline>
  window.addEventListener("load", function () {
    var el = document.getElementById("search");
    var fallback = document.querySelector("[data-search-fallback]");
    if (window.PagefindUI && el) {
      /* GitHub Pages는 저장소 하위 경로에 올라가므로 결과 주소의 기준을 맞춘다 */
      var base = window.location.pathname.indexOf("/pre-work/") === 0 ? "/pre-work/" : "/";
      new window.PagefindUI({ element: "#search", showSubResults: true, baseUrl: base });
      if (fallback) fallback.hidden = true;
      /* `/` 키로 여기에 도착했으면 곧바로 입력란으로 보낸다 */
      try {
        if (sessionStorage.getItem("pw-focus-search") === "1") {
          sessionStorage.removeItem("pw-focus-search");
          var input = el.querySelector("input");
          if (input) input.focus();
        }
      } catch (e) {}
    }
  });
</script>
