---
import Layout from "../../layouts/Layout.astro";
import { issues } from "../../data/issues";

export function getStaticPaths() {
  const tags = new Set<string>();
  for (const issue of issues) {
    for (const tag of issue.tags) tags.add(tag);
  }
  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const tagged = issues.filter((issue) => issue.tags.includes(tag));
const total = tagged.reduce((n, issue) => n + issue.minutes, 0);
---

<Layout title={`${tag} · 태그`} description={`'${tag}' 태그가 붙은 호 목록입니다.`}>
  <header class="workspace-head">
    <div>
      <p class="workspace-head__eyebrow mono"><a href="/tags/">← 태그</a></p>
      <h1>{tag}</h1>
      <p>'{tag}' 태그가 붙은 호를 최신부터 모았습니다.</p>
    </div>
    <div class="workspace-head__meta mono">{tagged.length}개 호 · 누적 {total}분</div>
  </header>

  <ol class="issue-list">
    {tagged.map((issue) => (
      <li>
          <a href={`/read/${issue.no}/`} data-read-mark={`issue-${issue.no}`}>
          <span class="issue-list__no mono">제{issue.no}호</span>
          <div class="issue-list__main">
            <p class="issue-list__title">{issue.title}</p>
            <p class="issue-list__dek">{issue.dek}</p>
            <div class="tag-list">{issue.tags.map((t) => <span>{t}</span>)}</div>
          </div>
          <div class="issue-list__meta mono">
            <span>{issue.date} ({issue.weekday})</span>
            <span>{issue.minutes}분</span>
            <span class="issue-list__read" data-read-badge>읽음</span>
          </div>
        </a>
      </li>
    ))}
  </ol>
</Layout>

<script>
  /* 읽은 호 표시 — 홈 목록과 같은 규칙 */
  const KEY = "pw-read";
  let read: string[] = [];
  try {
    read = JSON.parse(localStorage.getItem(KEY) ?? "[]");
  } catch (e) {
    read = [];
  }
  document.querySelectorAll<HTMLElement>("[data-read-mark]").forEach((el) => {
    if (read.includes(el.dataset.readMark!)) el.dataset.read = "true";
  });
</script>
