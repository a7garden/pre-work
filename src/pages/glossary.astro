---
import Layout from "../layouts/Layout.astro";

const groups = [
  {
    id: "common",
    label: "공통 · 프로젝트 조직",
    terms: [
      ["Co-op", "표준 현장실습학기제. 교육부 고시에 따라 학교·기관·학생이 3자 협약을 맺고 진행하는 정식 학사 절차형 실습."],
      ["SI", "System Integration. 하드웨어·소프트웨어·네트워크를 하나의 정보시스템으로 통합·구축하는 사업."],
      ["SP 인증", "소프트웨어사업자 신고 및 품질 관련 인증 체계. 공공 SW 사업 참여 자격·품질 수준을 나타내는 제도."],
      ["SDLC", "Software Development Life Cycle. 요구사항 분석부터 유지보수까지 소프트웨어 개발 전체 생애주기."],
      ["폭포수 모델", "분석 → 설계 → 구현 → 시험 순서로 한 단계씩 확정하며 진행하는 개발 방식. 공공 SI의 기본 진행 방식."],
      ["마르미-III", "공공 정보화 사업 표준 방법론. 단계별로 작성해야 할 산출물의 종류와 양식을 정의한다."],
    ],
  },
  {
    id: "design",
    label: "요구사항 · 설계 · 데이터",
    terms: [
      ["요구사항정의서", "시스템이 해야 할 일(기능)과 지켜야 할 조건(비기능)을 정리한 문서. 이후 모든 산출물의 기준선."],
      ["WBS", "Work Breakdown Structure. 프로젝트 전체를 세부 작업 단위로 쪼갠 계층형 작업분할구조도."],
      ["화면설계서", "화면 레이아웃과 데이터 흐름을 정의한 문서. 와이어프레임(저충실도)·목업(고충실도)을 포함."],
      ["ERD", "Entity-Relationship Diagram. 데이터베이스 테이블과 테이블 간 관계를 그림으로 표현한 다이어그램."],
      ["테이블명세서", "각 테이블의 컬럼명·데이터 타입·제약조건을 정리한 문서. ERD보다 한 단계 더 구체적."],
      ["PK / FK", "기본키(Primary Key)는 행을 고유 식별하는 값, 외래키(Foreign Key)는 다른 테이블의 PK를 참조해 관계를 맺는 값."],
      ["정규화", "데이터 중복을 줄이기 위해 테이블을 목적에 맞게 분리하는 데이터베이스 설계 원칙."],
    ],
  },
  {
    id: "dev",
    label: "개발 · 형상관리 · 품질관리",
    terms: [
      ["Git", "분산형 형상관리 도구. 개발자마다 전체 변경 이력을 로컬에 보관하며 브랜치 생성이 가볍다."],
      ["SVN", "중앙집중형 형상관리 도구. 서버 한 곳에 전체 이력을 두며, 레거시 유지보수 프로젝트에서 여전히 쓰인다."],
      ["IDE", "Integrated Development Environment. 코드 작성·실행·디버깅을 한 프로그램 안에서 처리하는 통합 개발 환경."],
      ["API / REST API", "서로 다른 프로그램이 정해진 규칙으로 데이터를 주고받는 창구. REST는 URL·HTTP 메서드 기반의 대표적 설계 방식."],
      ["Unit Test", "함수·메서드 단위로 의도대로 동작하는지 자동화된 코드로 검증하는 테스트. Given–When–Then 구조가 흔하다."],
      ["통합 테스트", "여러 모듈을 실제로 연결한 상태에서 시나리오 기반으로 전체 동작을 검증하는 테스트."],
      ["코드 리뷰", "코드를 병합하기 전 동료·담당자가 미리 확인하는 절차. 실습 기간 내내 반복되는 품질관리 활동."],
      ["버그 트래킹", "발견한 결함을 이슈로 등록해 재현 절차·기대 결과·실제 결과·우선순위를 기록하고 추적하는 절차."],
      ["Gap 분석", "요구사항정의서와 실제 구현 결과물을 비교해 빠지거나 다르게 만들어진 부분을 찾아내는 작업."],
    ],
  },
  {
    id: "ai",
    label: "AI · 자연어처리 · LLM",
    terms: [
      ["NLP", "자연어 처리(Natural Language Processing). 사람의 언어를 컴퓨터가 이해·처리하도록 다루는 기술 분야."],
      ["토큰화 · 임베딩", "문장을 의미 단위로 쪼개는 것이 토큰화, 그 단위를 숫자 벡터로 바꾸는 것이 임베딩."],
      ["LLM", "Large Language Model. 방대한 텍스트로 학습해 다음 토큰을 확률적으로 예측·생성하는 대규모 언어모델."],
      ["Transformer · 어텐션", "현대 LLM의 기반 구조. 어텐션은 문장 내 단어들의 관련도를 계산해 먼 단어 간 관계도 포착하는 메커니즘."],
      ["LangChain", "LLM 호출·프롬프트 관리·외부 데이터 연결·대화 이력 관리를 표준 부품으로 제공하는 챗봇 개발 프레임워크."],
      ["프롬프트 엔지니어링", "모델에게 주는 지시문(prompt)을 설계해 원하는 형태·품질의 답을 얻어내는 기법."],
      ["RAG", "Retrieval-Augmented Generation, 검색 증강 생성. 답변 전에 관련 문서를 검색해 근거로 함께 제공, 환각을 줄이는 방식."],
      ["벡터DB", "문서를 임베딩한 벡터를 저장해두고, 의미가 가장 가까운 벡터를 빠르게 찾아주는 데이터베이스."],
      ["환각 (Hallucination)", "LLM이 사실이 아닌 내용을 그럴듯하게 생성해내는 현상. RAG·프롬프트 설계로 완화한다."],
      ["페르소나", "챗봇의 말투·태도·응답 범위를 일관되게 정의한 것. 벤치마킹을 통해 기능과 함께 설계한다."],
    ],
  },
];

const total = groups.reduce((n, g) => n + g.terms.length, 0);
---

<Layout
  title="핵심 용어 사전"
  description="SI 트랙과 AI Chatbot 트랙에서 반복해서 등장하는 핵심 용어를 한 번에 정리했습니다."
>
  <div class="page-head">
    <span class="page-head__kicker mono">03 · 참고 자료</span>
    <h1>핵심 용어 사전</h1>
    <p class="lede">
      <a href="/si-track/">SI 트랙</a>과 <a href="/ai-track/">AI Chatbot 트랙</a>을
      읽다가 낯선 단어가 나오면 이 페이지에서 바로 찾아보세요. 총 {total}개 용어를
      네 갈래로 묶었습니다.
    </p>
  </div>

  <div class="toc">
    <p class="caps">용어 갈래</p>
    <ol>
      {groups.map((g) => (
        <li><a href={`#${g.id}`}>{g.label} ({g.terms.length})</a></li>
      ))}
    </ol>
  </div>

  <article class="prose">
    {groups.map((g) => (
      <>
        <h2 id={g.id}>{g.label}</h2>
        <div class="spec-sheet-wrap">
          <table class="spec-sheet">
            {g.terms.map(([term, def]) => (
              <tr>
                <th><span class="mono" style="color: var(--color-ink); font-weight: 600;">{term}</span></th>
                <td>{def}</td>
              </tr>
            ))}
          </table>
        </div>
      </>
    ))}
  </article>
</Layout>
