---
import Layout from "../layouts/Layout.astro";
import { glossary, categoryLabels, categoryOrder, termById } from "../data/glossary";

const grouped = categoryOrder
  .map((cat) => ({ cat, label: categoryLabels[cat], terms: glossary.filter((t) => t.category === cat) }))
  .filter((g) => g.terms.length > 0);
---

<Layout
  title="용어 사전"
  description="실무 코드와 문서에서 반복해 나오는 용어를 한 줄 정의와 실제 쓰임으로 정리했습니다. 본문 어디서나 밑줄 친 단어에 마우스를 올리면 같은 정의가 바로 나옵니다."
>
  <header class="workspace-head">
    <div>
      <p class="workspace-head__eyebrow mono">GLOSSARY</p>
      <h1>용어 사전</h1>
      <p>
        사이트 본문에서 점선 밑줄이 있는 단어는 마우스를 올리거나 눌러 뜻을 바로 볼 수 있습니다.
        여기서는 그 정의의 원본과, 코드에서 실제로 어떤 모습으로 나타나는지를 함께 봅니다.
      </p>
    </div>
    <div class="workspace-head__meta mono">{glossary.length}개 용어</div>
  </header>

  <div class="note-toolbar">
    <label class="note-search">
      <span class="sr-only">용어 검색</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m1.35-5.15a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z" /></svg>
      <input id="term-search" type="search" placeholder="용어, 뜻, 어노테이션 검색" autocomplete="off" />
    </label>
    <span class="note-toolbar__hint mono">/ to search</span>
  </div>

  <div class="cat-filter" role="group" aria-label="갈래 거르기">
    <button type="button" class="cat-chip" data-cat="all" aria-pressed="true">전체</button>
    {grouped.map((g) => (
      <button type="button" class="cat-chip" data-cat={g.cat} aria-pressed="false">
        {g.label} <span class="mono">{g.terms.length}</span>
      </button>
    ))}
  </div>

  <div class="gl">
    {grouped.map((group) => (
      <section class="gl__group" data-cat-section={group.cat}>
        <h2 id={group.cat}>{group.label}</h2>
        <div class="gl__items">
          {group.terms.map((t) => (
            <article
              class="gl-item"
              id={t.id}
              data-cat={t.category}
              data-search={`${t.term} ${(t.aliases ?? []).join(" ")} ${t.short} ${t.long ?? ""}`.toLocaleLowerCase()}
            >
              <div class="gl-item__head">
                <h3>{t.term}</h3>
                {t.aliases && t.aliases.length > 0 && (
                  <p class="gl-item__alias mono">{t.aliases.join(" · ")}</p>
                )}
              </div>
              <p class="gl-item__short">{t.short}</p>
              {t.long && <p class="gl-item__long">{t.long}</p>}
              {t.example && <pre class="gl-item__ex"><code>{t.example}</code></pre>}
              {(t.related?.length || t.see?.length) && (
                <div class="gl-item__foot">
                  {t.related && t.related.length > 0 && (
                    <p class="gl-item__rel">
                      <span class="mono">함께 보기</span>
                      {t.related.map((id) => {
                        const r = termById(id);
                        return r ? <a href={`#${r.id}`}>{r.term}</a> : null;
                      })}
                    </p>
                  )}
                  {t.see && t.see.map((s) => (
                    <a class="gl-item__see" href={s.href}>{s.label} <span aria-hidden="true">→</span></a>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <p class="note-empty" id="gl-empty" hidden>찾는 용어가 없습니다. 다른 낱말로 검색하거나 갈래를 바꿔 보세요.</p>
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>("#term-search");
  const items = [...document.querySelectorAll<HTMLElement>(".gl-item")];
  const sections = [...document.querySelectorAll<HTMLElement>("[data-cat-section]")];
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".cat-chip")];
  const empty = document.querySelector<HTMLElement>("#gl-empty");
  let cat = "all";

  function apply() {
    const query = input?.value.trim().toLocaleLowerCase() ?? "";
    let visible = 0;

    sections.forEach((section) => {
      const inCat = cat === "all" || section.dataset.catSection === cat;
      let shown = 0;
      section.querySelectorAll<HTMLElement>(".gl-item").forEach((item) => {
        const match = inCat && (!query || (item.dataset.search ?? "").includes(query));
        item.hidden = !match;
        if (match) shown += 1;
      });
      section.hidden = shown === 0;
      visible += shown;
    });

    if (empty) empty.hidden = visible !== 0;
  }

  input?.addEventListener("input", apply);
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      cat = chip.dataset.cat ?? "all";
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      apply();
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "/" && document.activeElement?.tagName !== "INPUT") {
      event.preventDefault();
      input?.focus();
    }
  });

  /* 다른 페이지에서 #앵커로 들어오면 그 항목을 잠깐 강조한다 */
  function highlightHash() {
    const id = location.hash.slice(1);
    if (!id) return;
    const el = document.getElementById(id);
    if (!el || !el.classList.contains("gl-item")) return;
    items.forEach((i) => i.removeAttribute("data-focus"));
    el.setAttribute("data-focus", "true");
  }
  highlightHash();
  window.addEventListener("hashchange", highlightHash);
</script>
