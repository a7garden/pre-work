---
import Layout from "../../layouts/Layout.astro";
import Blocks from "../../components/Blocks.astro";
import RichText from "../../components/RichText.astro";
import { issues } from "../../data/issues";

export function getStaticPaths() {
  return issues.map((issue, index) => ({
    params: { no: String(issue.no) },
    props: {
      issue,
      newer: issues[index - 1] ?? null,
      older: issues[index + 1] ?? null,
    },
  }));
}

const { issue, newer, older } = Astro.props;
const seen = new Set<string>();

/* 같은 시리즈의 호들 — 오래된 순으로 나열해 읽는 순서를 보여 준다 */
const seriesIssues = issue.series
  ? issues.filter((i) => i.series === issue.series).sort((a, b) => a.no - b.no)
  : [];
const seriesPart = seriesIssues.findIndex((i) => i.no === issue.no) + 1;

---
<Layout title={`제${issue.no}호 · ${issue.title}`} description={issue.dek} progress>
  <article class="issue">
    <a class="back-link mono" href="/daily/">← 데일리 아카이브</a>

    <header class="issue__head">
      <p class="issue__stamp mono">
        <span>제{issue.no}호</span>
        <span>{issue.date} ({issue.weekday})</span>
        <span>{issue.minutes}분</span>
      </p>
      <h1>{issue.title}</h1>
      <p class="issue__dek">{issue.dek}</p>
      <div class="tag-list">
        {issue.series && <span class="issue__series-chip mono">{issue.series}</span>}
        {issue.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
      </div>
    </header>

    <p class="issue__takeaway">
      <span class="mono">오늘 남길 한 문장</span>
      <strong><span><RichText text={issue.takeaway} seen={seen} /></span></strong>
    </p>

    {issue.series && (
      <aside class="issue__series">
        <p class="mono">시리즈 · {issue.series} ({seriesPart}/{seriesIssues.length})</p>
        <ol>
          {seriesIssues.map((s) => (
            <li aria-current={s.no === issue.no ? "page" : undefined}>
              <a href={`/daily/${s.no}/`}>
                <span class="mono">제{s.no}호</span>
                <span>{s.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    )}

    <div class="doc issue__body">
      <Blocks blocks={issue.blocks} seen={seen} />
    </div>

    {issue.next && (
      <aside class="issue__next">
        <p class="mono">내일 이어서</p>
        <p>{issue.next}</p>
      </aside>
    )}

    <nav class="issue__nav" aria-label="다른 호로 이동">
      {older ? (
        <a href={`/daily/${older.no}/`} class="issue__nav-link">
          <span class="mono">← 제{older.no}호</span>
          <span>{older.title}</span>
        </a>
      ) : <span></span>}
      {newer ? (
        <a href={`/daily/${newer.no}/`} class="issue__nav-link issue__nav-link--next">
          <span class="mono">제{newer.no}호 →</span>
          <span>{newer.title}</span>
        </a>
      ) : <span></span>}
    </nav>
  </article>
</Layout>

<script define:vars={{ no: issue.no }}>
  /* 끝까지 읽으면 이 호를 읽음으로 표시한다 */
  const KEY = "pw-read";
  const mark = () => {
    if (window.scrollY + window.innerHeight < document.documentElement.scrollHeight - 200) return;
    let read = [];
    try {
      read = JSON.parse(localStorage.getItem(KEY) ?? "[]");
    } catch (e) {
      read = [];
    }
    const id = `issue-${no}`;
    if (!read.includes(id)) {
      read.push(id);
      try {
        localStorage.setItem(KEY, JSON.stringify(read));
      } catch (e) {}
    }
    window.removeEventListener("scroll", mark);
  };
  window.addEventListener("scroll", mark, { passive: true });
</script>
