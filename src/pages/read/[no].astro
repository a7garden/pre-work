---
import Layout from "../../layouts/Layout.astro";
import Blocks from "../../components/Blocks.astro";
import RichText from "../../components/RichText.astro";
import Icon from "../../components/Icon.astro";
import { issues } from "../../data/issues";

export function getStaticPaths() {
  return issues.map((issue, index) => ({
    params: { no: String(issue.no) },
    props: {
      issue,
      newer: issues[index - 1] ?? null,
      older: issues[index + 1] ?? null,
    },
  }));
}

const { issue, newer, older } = Astro.props;

/* 같은 시리즈의 호들 — 오래된 순으로 나열해 읽는 순서를 보여 준다 */
const seriesIssues = issue.series
  ? issues.filter((i) => i.series === issue.series).sort((a, b) => a.no - b.no)
  : [];
const seriesPart = seriesIssues.findIndex((i) => i.no === issue.no) + 1;

---
<Layout title={`제${issue.no}호 · ${issue.title}`} description={issue.dek} progress>
  <article class="issue" data-pagefind-body>
    <a data-pagefind-ignore class="back-link mono" href="/"><Icon name="arrow-left" size={16} />전체 목록</a>

    <header class="issue__head">
      <p class="issue__stamp mono" data-pagefind-ignore>
        <span>제{issue.no}호</span>
        <span><Icon name="calendar" size={16} />{issue.date} ({issue.weekday})</span>
        <span><Icon name="clock" size={16} />{issue.minutes}분</span>
        <button class="copy-link" type="button" data-copy-link aria-label="이 글의 주소 복사" aria-live="polite">
          <span class="copy-link__idle"><Icon name="copy" size={16} />주소 복사</span>
          <span class="copy-link__done"><Icon name="check" size={16} />복사됨</span>
          <span class="copy-link__error">복사 실패 · 재시도</span>
        </button>
      </p>
      <h1 data-pagefind-meta="title">{issue.title}</h1>
      <p class="issue__dek">{issue.dek}</p>
      <div class="tag-list">
        {issue.series && <span class="issue__series-chip mono">{issue.series}</span>}
        {issue.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
      </div>
    </header>

    <p class="issue__takeaway">
      <span class="mono">오늘 남길 한 문장</span>
      <strong><span><RichText text={issue.takeaway} /></span></strong>
    </p>

    {issue.series && (
      <details class="series-contents" data-pagefind-ignore>
        <summary>{issue.series} · {seriesPart}/{seriesIssues.length}편</summary>
        <aside class="issue__series">
        <p class="mono">시리즈 · {issue.series} ({seriesPart}/{seriesIssues.length})</p>
        <ol>
          {seriesIssues.map((s) => (
            <li aria-current={s.no === issue.no ? "page" : undefined}>
              <a href={`/read/${s.no}/`}>
                <span class="mono">제{s.no}호</span>
                <span>{s.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
      </details>
    )}

    <div class="doc issue__body">
      <Blocks blocks={issue.blocks} />
    </div>

    {issue.next && (
      <aside class="issue__next">
        <p class="mono">이어서 읽을 주제</p>
        <p>{issue.next}</p>
      </aside>
    )}

    <nav data-pagefind-ignore class="issue__nav" aria-label="다른 호로 이동">
      {older ? (
        <a href={`/read/${older.no}/`} class="issue__nav-link">
          <span class="mono"><Icon name="arrow-left" size={16} />제{older.no}호</span>
          <span>{older.title}</span>
        </a>
      ) : <span></span>}
      {newer ? (
        <a href={`/read/${newer.no}/`} class="issue__nav-link issue__nav-link--next">
          <span class="mono">제{newer.no}호<Icon name="arrow-right" size={16} /></span>
          <span>{newer.title}</span>
        </a>
      ) : <span></span>}
    </nav>
  </article>
</Layout>

<script define:vars={{ no: issue.no }}>
  /* 끝까지 읽으면 이 호를 읽음으로 표시한다 */
  const KEY = "pw-read";
  const mark = () => {
    if (window.scrollY + window.innerHeight < document.documentElement.scrollHeight - 200) return;
    let read = [];
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) ?? "[]");
      read = Array.isArray(saved) ? saved : [];
    } catch (e) {
      read = [];
    }
    const id = `issue-${no}`;
    if (!read.includes(id)) {
      read.push(id);
      try {
        localStorage.setItem(KEY, JSON.stringify(read));
      } catch (e) {}
    }
    window.removeEventListener("scroll", mark);
  };
  window.addEventListener("scroll", mark, { passive: true });
</script>

<script>
  /* ← / → — 이전·다음 호. 입력 요소에서는 무시한다 */
  document.addEventListener("keydown", (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
    const target = event.target as HTMLElement | null;
    if (target?.closest("input, textarea, select, [contenteditable='true']")) return;
    if (event.key === "ArrowLeft") {
      document.querySelector<HTMLAnchorElement>(".issue__nav-link:not(.issue__nav-link--next)")?.click();
    }
    if (event.key === "ArrowRight") {
      document.querySelector<HTMLAnchorElement>(".issue__nav-link--next")?.click();
    }
  });

  /* 주소 복사 — 라벨 스왑이 피드백이다. 토스트는 없다 */
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy-link]");
  copyBtn?.addEventListener("click", async () => {
    copyBtn.disabled = true;
    copyBtn.setAttribute("aria-busy", "true");
    try {
      await navigator.clipboard.writeText(window.location.href);
      copyBtn.dataset.state = "copied";
      window.setTimeout(() => {
        delete copyBtn.dataset.state;
      }, 2500);
    } catch {
      copyBtn.dataset.state = "error";
    } finally {
      copyBtn.disabled = false;
      copyBtn.removeAttribute("aria-busy");
    }
  });
</script>
