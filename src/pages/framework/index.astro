const configBlocks: Block[] = [
  {
    type: "p",
    text: "설정 파일은 세 층으로 읽는다. web.xml이 무엇을 켤지 정하고, context-*.xml이 애플리케이션 전체의 부품을 만들고, action-servlet.xml이 화면 처리 방법을 정한다. 이 순서가 곧 서버가 기동하는 순서다.",
  },
  {
    type: "codeRead",
    language: "xml",
    caption: "context-common.xml — 애플리케이션의 부품 창고",
    question: "이 파일 하나가 없으면 어떤 일이 벌어질까?",
    code: `<context:component-scan base-package="egovframework">
    <context:exclude-filter type="annotation"
        expression="org.springframework.stereotype.Controller" />
</context:component-scan>

<bean id="messageSource"
      class="org.springframework.context.support.ReloadableResourceBundleMessageSource">
    <property name="basenames">
        <list>
            <value>classpath:/egovframework/message/message-common</value>
        </list>
    </property>
</bean>

<bean name="egovIdGnrService"
      class="egovframework.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl">
    <property name="dataSource" ref="dataSource" />
    <property name="strategy"   ref="egovIdGnrStrategy" />
    <property name="blockSize"  value="10" />
    <property name="table"      value="COMTECOPSEQ" />
</bean>`,
    notes: [
      {
        lines: "1-4",
        title: "스캔 범위가 곧 빈의 존재 범위다",
        body: "base-package 밖에 만든 클래스는 어노테이션을 아무리 정확히 붙여도 등록되지 않는다. Controller를 제외하는 이유는 화면 관련 빈은 action-servlet.xml 쪽에서 따로 스캔하기 때문이다 — 같은 클래스가 두 컨테이너에 중복 등록되는 것을 막는 관례다.",
      },
      {
        lines: "6-14",
        title: "화면 문구가 코드에 없는 이유",
        body: "메시지는 properties 파일에 두고 키로 꺼내 쓴다. JSP의 <spring:message code=\"...\"/>나 검증 오류 문구가 여기서 온다. 문구를 바꾸라는 요청이 오면 Java가 아니라 message-common.properties를 찾는다.",
      },
      {
        lines: "16-22",
        title: "게시글 번호가 만들어지는 자리",
        body: "ID 생성 규칙이 코드가 아니라 설정에 있다. blockSize 10은 한 번에 10개씩 번호를 미리 받아 두고 쓴다는 뜻이라, 서버를 재시작하면 번호가 건너뛸 수 있다. 번호가 연속이 아니라는 문의는 대개 이 설정 때문이다.",
      },
    ],
  },
  {
    type: "codeRead",
    language: "xml",
    caption: "action-servlet.xml — 화면 처리 설정",
    question: "인터셉터와 ViewResolver 중 어느 쪽이 먼저 동작하는가?",
    code: `<mvc:interceptors>
    <mvc:interceptor>
        <mvc:mapping path="/**" />
        <mvc:exclude-mapping path="/uat/uia/**" />
        <bean class="egovframework.com.cmm.interceptor.AuthenticInterceptor" />
    </mvc:interceptor>
</mvc:interceptors>

<bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
    <property name="prefix" value="/WEB-INF/jsp/egovframework/" />
    <property name="suffix" value=".jsp" />
</bean>

<bean id="multipartResolver"
      class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
    <property name="maxUploadSize" value="10485760" />
</bean>`,
    notes: [
      {
        lines: "1-7",
        title: "로그인 없이 튕겨 나가는 지점",
        body: "인터셉터는 Controller보다 먼저 실행된다. path=\"/**\"로 전부 걸고 로그인 화면 경로만 제외하는 형태가 표준이다. 특정 화면만 계속 로그인 화면으로 돌아간다면 이 exclude-mapping 목록을 확인한다.",
      },
      {
        lines: "9-12",
        title: "뷰 이름이 파일이 되는 계산식",
        body: "Controller의 return 값 앞뒤에 이 두 문자열이 붙는다. 인터셉터를 통과한 뒤, Controller가 끝난 다음에 동작하므로 순서상 가장 나중이다.",
      },
      {
        lines: "14-17",
        title: "첨부파일 크기 제한",
        body: "10485760은 10MB다. 파일 업로드가 조용히 실패한다면 이 값과 Apache·Tomcat 쪽 제한을 함께 본다. 어느 한 층에서만 늘려도 통과하지 않는다.",
      },
    ],
  },
];

